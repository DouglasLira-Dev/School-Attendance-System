<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissões de localização (para registrar geolocalização na chamada) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Permissão para notificações (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Permissão para biometria (FaceID/impressão digital) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Permissão para agendar alarmes exatos -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FrequenciaEscolar"
        tools:targetApi="31">

        <!-- Tela de Login (Tela inicial) -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tela de Configuração de Senha (primeiro acesso) -->
        <activity
            android:name=".ui.auth.ConfigSenhaActivity"
            android:exported="false" />

        <!-- Tela de Turmas -->
        <activity
            android:name=".ui.turmas.TurmaListActivity"
            android:exported="false" />

        <!-- Tela de Formulário de Turma -->
        <activity
            android:name=".ui.turmas.TurmaFormActivity"
            android:exported="false" />

        <!-- Tela de Listagem de Alunos -->
        <activity
            android:name=".ui.alunos.AlunoListActivity"
            android:exported="false" />

        <!-- Tela de Formulário de Aluno -->
        <activity
            android:name=".ui.alunos.AlunoFormActivity"
            android:exported="false" />

        <!-- Tela de Detalhes do Aluno -->
        <activity
            android:name=".ui.alunos.AlunoDetalheActivity"
            android:exported="false" />

        <!-- Tela de Matrícula/Transferência/Expulsão -->
        <activity
            android:name=".ui.alunos.MatriculaActivity"
            android:exported="false" />

        <!-- Tela de Chamada para registro de frequência -->
        <activity
            android:name=".ui.chamada.ChamadaActivity"
            android:exported="false" />

        <!-- Tela de Relatórios e Estatísticas -->
        <activity
            android:name=".ui.relatorios.RelatorioDashboardActivity"
            android:exported="false" />

        <!-- Receptor para notificações agendadas -->
        <receiver
            android:name=".utils.NotificationReceiver"
            android:exported="false" />

        <!-- Tela de Configurações -->
        <activity
            android:name=".ui.configuracoes.ConfiguracoesActivity"
            android:exported="false" />

    </application>

</manifest>